# Normalise line endings. Windows .bat and .ps1 files must always use CRLF; shell scripts must use LF.
* text=auto
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
*.png binary
*.ico binary

# Not needed by someone who just wants the source archive GitHub generates for a tag.
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/CLAUDE.md export-ignore
/docs export-ignore
/test export-ignore
/tools/icon-src export-ignore
/tools/make-ico.mjs export-ignore
/tools/package export-ignore
/tools/release-notes.mjs export-ignore
