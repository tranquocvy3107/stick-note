# Chuẩn hóa xuống dòng. File .bat và .ps1 của Windows luôn dùng CRLF.
* text=auto
*.bat text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.ico binary

# Những thứ này không đưa vào gói phát hành (git archive) vì người dùng cuối không cần.
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/CLAUDE.md export-ignore
/docs export-ignore
/test export-ignore
/tools/icon-src export-ignore
/tools/make-ico.mjs export-ignore
/tools/release-notes.mjs export-ignore
