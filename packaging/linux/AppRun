#!/bin/sh
# What runs when the AppImage is started.
#
# "--run" keeps the server in the foreground. With "--open" the server would start in the background
# and AppRun would exit at once; the AppImage then unmounts itself and the background server would
# lose the files it is running from.
APPDIR="${APPDIR:-$(dirname "$(readlink -f "$0")")}"
exec "$APPDIR/usr/lib/stick-note/stick-note" --run "$@"
