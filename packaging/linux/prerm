#!/bin/sh
# Stop a running Stick Note before its files are removed or replaced (package removal and upgrade).
# The notes live in each user's own folder and are never touched here.
set -e

case "$1" in
  remove|upgrade|deconfigure)
    if [ -x /usr/lib/stick-note/stick-note ]; then
      /usr/lib/stick-note/stick-note --stop || true
    fi
    ;;
esac

exit 0
